# これは公開用テンプレート。実値は .env（gitignore済）に置く。
# 画面内OCRで見つかったらマスク（読めないぼかし）する語のカンマ区切りリスト。
# 個人名・ハンドル等のPII。本名やアカウントIDをここに列挙する。
WWEDIT_MASK_TERMS=姓,名,handle1,handle2
# NGワード（カンマ区切り）。この語に言及した発話(utterance)はカット対象にする
# （cut ngwords 工程）。語そのものは秘匿＝ここ(.env)だけに置きコード/リポジトリに書かない。
WWEDIT_CUT_NGWORDS=NG語1,NG語2
DOMOAI_API_KEY=https://platform.domoai.com/organization/************/api-keys